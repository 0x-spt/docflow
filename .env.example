# Postgres из docker-compose опубликован на 55432: 5432 оставлен локальному Postgres
DOCFLOW_DATABASE_URL=postgresql+asyncpg://docflow:docflow@localhost:55432/docflow
DOCFLOW_REDIS_URL=redis://localhost:6379/0
DOCFLOW_BLOB_BACKEND=local
DOCFLOW_BLOB_ROOT=data/blobs
# для DOCFLOW_BLOB_BACKEND=s3 (SeaweedFS из docker-compose; ключи — docker/s3.json)
DOCFLOW_S3_ENDPOINT=http://localhost:8333
DOCFLOW_S3_BUCKET=docflow
DOCFLOW_S3_ACCESS_KEY=docflow
DOCFLOW_S3_SECRET_KEY=docflow-secret
DOCFLOW_ANTHROPIC_MODEL=claude-opus-5-5
DOCFLOW_OLLAMA_URL=http://localhost:11434
DOCFLOW_OLLAMA_MODEL=qwen2.5vl:7b
DOCFLOW_MAX_FILE_MB=20
DOCFLOW_MAX_PAGES=30
# ключ SDK читает сам
ANTHROPIC_API_KEY=
