# Образец .env. Его читают и приложение при запуске с хоста (uv run ...), и docker compose — для подстановки
# секретов в docker-compose.yml. Значения ниже годятся только для локальной разработки: в проде смените все три
# секрета (Postgres, Redis, S3) — см. README, «Запуск в проде».

# --- секреты стека docker compose ---
DOCFLOW_PG_USER=docflow
DOCFLOW_PG_PASSWORD=docflow
# Redis хранит задачи arq в pickle: пароль обязателен, наружу порт не публикуем
DOCFLOW_REDIS_PASSWORD=docflow-dev
# ключи S3 (SeaweedFS берёт их отсюда при старте): только буквы, цифры, - и _
DOCFLOW_S3_ACCESS_KEY=docflow
DOCFLOW_S3_SECRET_KEY=docflow-secret
# общий секрет сайта и API: по нему API верит адресу посетителя (X-Client-IP) от сайта. Задайте случайное значение,
# например `python -c "import secrets; print(secrets.token_urlsafe(32))"`; пусто — API не верит X-Client-IP и
# считает лимиты на вход и заявки по адресу контейнера сайта (общие для всех посетителей)
DOCFLOW_INTERNAL_TOKEN=
# ключ шифрования секретов получателей выгрузки (токены 1С, Битрикс24, amoCRM, Telegram, SMTP) — Fernet.
# ЗНАЧЕНИЕ НИЖЕ — ТОЛЬКО ДЛЯ DEV, оно публично. В проде сгенерируйте свой и сохраните: потерянный ключ делает
# сохранённые секреты нечитаемыми (подключения придётся ввести заново). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCFLOW_SECRETS_KEY=qJl-vgahho6EULOSxx57QSyVWVkyhUWM1plsDzs3obI=
# Secure у cookie сессии сайта: false — только для dev по http; в проде за https — true
COOKIE_SECURE=false

# --- приложение с хоста против стека compose ---
# Postgres из docker-compose опубликован на 127.0.0.1:55432: 5432 оставлен локальному Postgres
DOCFLOW_DATABASE_URL=postgresql+asyncpg://docflow:docflow@localhost:55432/docflow
# пароль — тот же, что DOCFLOW_REDIS_PASSWORD
DOCFLOW_REDIS_URL=redis://:docflow-dev@localhost:6379/0
DOCFLOW_BLOB_BACKEND=local
DOCFLOW_BLOB_ROOT=data/blobs
# для DOCFLOW_BLOB_BACKEND=s3 (SeaweedFS из docker-compose; ключи — DOCFLOW_S3_ACCESS_KEY/SECRET_KEY выше)
DOCFLOW_S3_ENDPOINT=http://localhost:8333
DOCFLOW_S3_BUCKET=docflow
# внешний адрес API: попадает в pdf_url ответов и вебхуков
DOCFLOW_PUBLIC_BASE_URL=http://localhost:8000
# внешний адрес кабинета: ссылки на документ и PDF в CRM, таблицах, Excel и уведомлениях (в проде — обязательно)
DOCFLOW_PUBLIC_SITE_URL=http://localhost:3000
DOCFLOW_ANTHROPIC_MODEL=claude-opus-5-5
# лёгкая модель для определения типа документа
DOCFLOW_ANTHROPIC_CLASSIFY_MODEL=claude-haiku-5-5
DOCFLOW_OLLAMA_URL=http://localhost:11434
# 19 ГБ; на видеокартах Turing (RTX 20xx) Ollama 0.40 падает на CUDA — запускать с OLLAMA_LLM_LIBRARY=vulkan
DOCFLOW_OLLAMA_MODEL=qwen3-vl:30b-a3b-instruct
DOCFLOW_MAX_FILE_MB=20
DOCFLOW_MAX_PAGES=30
# потолок всего тела POST /v1/documents
DOCFLOW_MAX_REQUEST_MB=200
# вебхуки на частные/loopback адреса: только dev и e2e
DOCFLOW_WEBHOOK_ALLOW_PRIVATE=false
# ключ SDK читает сам
ANTHROPIC_API_KEY=
# необязательно: адрес Bot API, другой нужен только для заглушки или своего сервера
DOCFLOW_TELEGRAM_API_URL=https://api.telegram.org
# уведомления о заявках с сайта в Telegram (пусто = не отправлять)
DOCFLOW_LEADS_TG_TOKEN=
DOCFLOW_LEADS_TG_CHAT=
