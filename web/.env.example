# Адрес API DocFlow (в docker compose — http://api:8000)
DOCFLOW_API_URL=http://localhost:8000
# Публичный адрес API для примеров в кабинете (то, что клиент вписывает в свою интеграцию)
DOCFLOW_PUBLIC_API_URL=http://localhost:8000
# Общий секрет сайта и API: по нему API доверяет X-Client-IP (то же случайное значение, что DOCFLOW_INTERNAL_TOKEN
# у API; пусто — API считает лимиты по адресу сайта)
DOCFLOW_INTERNAL_TOKEN=
# false — не ставить Secure на cookie сессии (dev по http); в проде за https не задавать
COOKIE_SECURE=false
