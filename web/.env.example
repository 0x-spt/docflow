# Адрес API DocFlow (в docker compose — http://api:8000)
DOCFLOW_API_URL=http://localhost:8000
# Общий секрет сайта и API: по нему API доверяет X-Client-IP (должен совпадать с internal_token API)
DOCFLOW_INTERNAL_TOKEN=docflow-internal-dev
# false — не ставить Secure на cookie сессии (dev по http); в проде за https не задавать
COOKIE_SECURE=false
